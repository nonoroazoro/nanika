{
  "name": "nanika-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm extensions:build && tauri dev",
    "build": "tauri build",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:check": "svelte-check --tsconfig frontend/tsconfig.app.json && tsc -p frontend/tsconfig.node.json",
    "extensions:build": "cargo build -p nanika-extension-application -p nanika-extension-command -p nanika-extension-script -p nanika-extension-calculator -p nanika-extension-clipboard",
    "lint": "eslint frontend --max-warnings 0",
    "format": "prettier --write frontend",
    "format:check": "prettier --check frontend",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:unit": "vitest run --config frontend/vitest.config.ts --project unit",
    "test:browser": "vitest run --config frontend/vitest.config.ts --project browser"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vitest-browser-svelte": "3.1.0"
  }
}
