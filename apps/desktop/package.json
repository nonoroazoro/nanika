{
    "name": "nanika-desktop",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "packageManager": "pnpm@11.25.0",
    "scripts": {
        "dev": "pnpm extensions:build && pnpm extensions:prepare && tauri dev",
        "build": "pnpm extensions:build:release && pnpm extensions:prepare:release && tauri build",
        "build:debug": "pnpm extensions:build && pnpm extensions:prepare && tauri build --debug --bundles app",
        "frontend:dev": "vite --config frontend/vite.config.ts",
        "frontend:build": "vite build --config frontend/vite.config.ts",
        "frontend:check": "svelte-check --tsconfig frontend/tsconfig.app.json && tsc -p frontend/tsconfig.node.json",
        "frontend:test": "node --test frontend/src/bridge/*.test.mjs frontend/src/settings/*.test.mjs",
        "extensions:build": "node ../../tooling/build/build-extensions.mjs debug",
        "extensions:build:release": "node ../../tooling/build/build-extensions.mjs release",
        "extensions:prepare": "node ../../tooling/build/prepare-extensions.mjs debug",
        "extensions:prepare:release": "node ../../tooling/build/prepare-extensions.mjs release",
        "lint": "eslint frontend --max-warnings 0",
        "lint:fix": "eslint frontend --fix",
        "format": "dprint fmt",
        "format:check": "dprint check"
    },
    "dependencies": {
        "@tauri-apps/api": "2.11.1",
        "svelte": "5.57.0"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "@tauri-apps/cli": "2.11.4",
        "@tsconfig/svelte": "5.0.8",
        "@types/node": "24.13.3",
        "@typescript-eslint/eslint-plugin": "8.69.0",
        "@typescript-eslint/parser": "8.69.0",
        "dprint": "0.55.2",
        "eslint": "10.9.1",
        "eslint-config-zoro": "9.2.1",
        "eslint-plugin-svelte": "3.23.0",
        "svelte-check": "4.7.6",
        "typescript": "6.0.2",
        "vite": "8.2.2"
    }
}
