{
    "name": "nanika-desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "corepack pnpm extensions:build && corepack pnpm extensions:prepare && tauri dev",
        "build": "corepack pnpm extensions:build:release && corepack pnpm extensions:prepare:release && tauri build",
        "build:debug": "corepack pnpm extensions:build && corepack pnpm extensions:prepare && tauri build --debug --bundles app",
        "frontend:dev": "vite --config frontend/vite.config.ts",
        "frontend:build": "vite build --config frontend/vite.config.ts",
        "frontend:check": "svelte-check --tsconfig frontend/tsconfig.app.json && tsc -p frontend/tsconfig.node.json",
        "frontend:test": "node --test frontend/tests/bridge/*.test.ts frontend/tests/settings/*.test.ts",
        "extensions:build": "node ../../tooling/build/build-extensions.mjs debug",
        "extensions:build:release": "node ../../tooling/build/build-extensions.mjs release",
        "extensions:prepare": "node ../../tooling/build/prepare-extensions.mjs debug",
        "extensions:prepare:release": "node ../../tooling/build/prepare-extensions.mjs release",
        "lint": "eslint frontend --max-warnings 0",
        "lint:fix": "eslint frontend --fix",
        "format": "dprint fmt",
        "format:check": "dprint check"
    },
    "dependencies": {
        "@tauri-apps/api": "2.11.1",
        "svelte": "5.57.1"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "@tauri-apps/cli": "2.11.5",
        "@tsconfig/svelte": "5.0.8",
        "@types/node": "24.13.6",
        "@typescript-eslint/eslint-plugin": "8.70.0",
        "@typescript-eslint/parser": "8.70.0",
        "dprint": "0.57.4",
        "eslint": "9.39.5",
        "eslint-config-zoro": "9.3.0",
        "eslint-plugin-svelte": "3.23.0",
        "svelte-check": "4.7.6",
        "typescript": "6.0.2",
        "vite": "8.3.0"
    },
    "packageManager": "pnpm@12.5.1",
    "engines": {
        "node": ">=24 <25"
    }
}
