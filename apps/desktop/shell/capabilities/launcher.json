{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "Root Search can access Nanika's bounded application commands and Tauri's debug-only DevTools toggle.",
  "windows": ["launcher"],
  "permissions": [
    "core:webview:allow-internal-toggle-devtools",
    "allow-acknowledge-search",
    "allow-close-session",
    "allow-dismiss-launcher",
    "allow-read-context-menu",
    "allow-invoke-context-menu",
    "allow-invoke-candidate",
    "allow-open-session",
    "allow-open-settings",
    "allow-publish-query",
    "allow-read-results",
    "allow-view-event"
  ]
}
