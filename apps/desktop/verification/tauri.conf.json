{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Nanika Verification",
    "version": "0.1.0",
    "identifier": "app.nanika.verification",
    "build": { "frontendDist": "assets" },
    "app": {
        "windows": [],
        "security": {
            "freezePrototype": true,
            "csp": {
                "default-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost",
                "script-src": "'self' 'wasm-unsafe-eval'",
                "worker-src": "'self'",
                "img-src": "'self'",
                "style-src": "'self'"
            },
            "pattern": { "use": "isolation", "options": { "dir": "isolation" } },
            "capabilities": [{
                "identifier": "verification",
                "windows": ["verification"],
                "permissions": [
                    "allow-verification-report",
                    "allow-verification-progress",
                    "allow-verification-resources"
                ]
            }]
        }
    },
    "bundle": {
        "active": false,
        "icon": ["../shell/icons/32x32.png"],
        "macOS": { "minimumSystemVersion": "13.0" }
    }
}
