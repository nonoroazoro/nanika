{
  "extensions": [
    {
      "id": "com.nanika.application",
      "binaryName": "nanika-extension-application",
      "runtime": { "protocol": "nanika", "protocolVersion": 1 },
      "permissions": ["process.launch"],
      "contributes": {
        "configuration": {
          "title": "Applications",
          "properties": {
            "application.roots": {
              "type": "array",
              "title": "Additional roots",
              "description": "Absolute directories searched in addition to platform defaults.",
              "default": [],
              "maxItems": 256,
              "items": { "type": "string", "format": "path", "maxLength": 4096 }
            },
            "application.exclusions": {
              "type": "array",
              "title": "Excluded paths",
              "description": "Absolute paths excluded from application discovery.",
              "default": [],
              "maxItems": 256,
              "items": { "type": "string", "format": "path", "maxLength": 4096 }
            }
          }
        },
        "rootSearch": {}
      }
    },
    {
      "id": "com.nanika.command",
      "binaryName": "nanika-extension-command",
      "runtime": { "protocol": "nanika", "protocolVersion": 1 },
      "permissions": ["process.launch"],
      "contributes": { "rootSearch": {} }
    },
    {
      "id": "com.nanika.script",
      "binaryName": "nanika-extension-script",
      "runtime": { "protocol": "nanika", "protocolVersion": 1 },
      "permissions": ["process.launch"],
      "contributes": {
        "configuration": {
          "title": "Scripts",
          "properties": {
            "script.entries": {
              "type": "array",
              "title": "Scripts",
              "description": "Explicit script commands and their interpreters.",
              "default": [],
              "maxItems": 5000,
              "items": {
                "type": "object",
                "required": ["id", "title", "aliases", "interpreter", "script", "arguments", "workingDirectory"],
                "properties": {
                  "id": { "type": "string", "maxLength": 128 },
                  "title": { "type": "string", "maxLength": 4096 },
                  "aliases": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 4096 }
                  },
                  "interpreter": { "type": "string", "format": "path", "maxLength": 4096 },
                  "script": { "type": "string", "format": "path", "maxLength": 4096 },
                  "arguments": {
                    "type": "array",
                    "maxItems": 256,
                    "items": { "type": "string", "maxLength": 4096 }
                  },
                  "workingDirectory": { "type": "string", "format": "path", "maxLength": 4096 }
                }
              }
            }
          }
        },
        "rootSearch": {}
      }
    },
    {
      "id": "com.nanika.calculator",
      "binaryName": "nanika-extension-calculator",
      "runtime": { "protocol": "nanika", "protocolVersion": 1 },
      "permissions": ["clipboard.write"],
      "contributes": { "rootSearch": {} }
    },
    {
      "id": "com.nanika.clipboard",
      "binaryName": "nanika-extension-clipboard",
      "runtime": { "protocol": "nanika", "protocolVersion": 1 },
      "permissions": ["clipboard.write"],
      "contributes": {
        "commands": [
          {
            "command": "clipboard.history",
            "title": "Clipboard History",
            "description": "Search and copy previous clipboard content.",
            "icon": "clipboard",
            "keywords": ["clipboard", "history", "paste"]
          }
        ],
        "configuration": {
          "title": "Clipboard History",
          "properties": {
            "clipboard.maxEntries": {
              "type": "integer",
              "title": "Maximum history entries",
              "description": "Maximum number of clipboard history entries retained locally.",
              "default": 50,
              "minimum": 1,
              "maximum": 5000,
              "multipleOf": 1
            },
            "clipboard.maxAgeDays": {
              "type": "integer",
              "title": "Maximum age in days",
              "description": "Maximum age of clipboard history retained locally.",
              "default": 7,
              "minimum": 1,
              "maximum": 3650,
              "multipleOf": 1
            }
          }
        }
      }
    }
  ]
}
