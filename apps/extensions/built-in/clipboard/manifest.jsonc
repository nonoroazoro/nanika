{
  "format": "nanika-extension",
  "manifestVersion": 1,
  "id": "com.nanika.clipboard",
  "name": {
    "message": "extension-name"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": [
        "locales/en.ftl"
      ],
      "zh-Hans": [
        "locales/zh-Hans.ftl"
      ]
    }
  },
  "icon": "assets/icon.png",
  "version": "0.1.0",
  "hostApi": "^0.1",
  "targets": {
    "x86_64-pc-windows-msvc": {
      "entrypoint": "bin/x86_64-pc-windows-msvc/nanika-extension-clipboard.exe"
    },
    "aarch64-apple-darwin": {
      "entrypoint": "bin/aarch64-apple-darwin/nanika-extension-clipboard"
    },
    "x86_64-apple-darwin": {
      "entrypoint": "bin/x86_64-apple-darwin/nanika-extension-clipboard"
    }
  },
  "runtime": {
    "protocol": "nanika",
    "protocolVersion": 1
  },
  "permissions": [
    "clipboard.write"
  ],
  "contributes": {
    "views": [
      {
        "id": "clipboard.history",
        "title": {
          "message": "extension-name"
        },
        "description": {
          "message": "view-history-description"
        },
        "icon": "assets/icon.png",
        "keywords": [
          {
            "message": "keyword-clipboard"
          },
          {
            "message": "keyword-history"
          },
          {
            "message": "keyword-paste"
          }
        ],
        "category": {
          "message": "category-clipboard"
        }
      }
    ],
    "configuration": {
      "title": {
        "message": "extension-name"
      },
      "quickMenu": [
        {
          "title": {
            "message": "group-appearance"
          },
          "items": [
            {
              "kind": "toggle",
              "key": "clipboard.syntaxHighlighting"
            }
          ],
          "id": "appearance"
        },
        {
          "title": {
            "message": "group-danger-zone"
          },
          "items": [
            {
              "kind": "action",
              "id": "clipboard.clear"
            }
          ],
          "id": "danger-zone"
        }
      ],
      "actions": [
        {
          "buttonLabel": {
            "message": "setting-clipboard-clear-button-label"
          },
          "action": {
            "id": "clipboard.clear",
            "title": {
              "message": "action-clipboard-clear-title"
            },
            "style": "destructive",
            "enabled": true,
            "allow_default_execution": false,
            "confirmation_title": {
              "message": "action-clipboard-clear-confirmation-title"
            },
            "confirmation_description": {
              "message": "action-clipboard-clear-confirmation-description"
            },
            "group": {
              "id": "danger-zone",
              "title": {
                "message": "group-danger-zone"
              }
            }
          },
          "description": {
            "message": "setting-clipboard-clear-description"
          }
        }
      ],
      "properties": {
        "clipboard.syntaxHighlighting": {
          "type": "boolean",
          "title": {
            "message": "setting-clipboard-syntax-highlighting-title"
          },
          "group": {
            "id": "appearance",
            "title": {
              "message": "group-appearance"
            }
          },
          "order": 0,
          "description": {
            "message": "setting-clipboard-syntax-highlighting-description"
          },
          "persistence": "afterApply",
          "default": true
        },
        "clipboard.maxEntries": {
          "type": "integerLimit",
          "title": {
            "message": "setting-clipboard-max-entries-title"
          },
          "group": {
            "id": "history-retention",
            "title": {
              "message": "group-history-retention"
            }
          },
          "order": 1,
          "description": {
            "message": "setting-clipboard-max-entries-description"
          },
          "persistence": "beforeApply",
          "default": {
            "unlimited": false,
            "value": 50
          },
          "minimum": 1,
          "maximum": 5000,
          "multipleOf": 1
        },
        "clipboard.maxAgeDays": {
          "type": "integerLimit",
          "title": {
            "message": "setting-clipboard-max-age-days-title"
          },
          "group": {
            "id": "history-retention",
            "title": {
              "message": "group-history-retention"
            }
          },
          "order": 2,
          "description": {
            "message": "setting-clipboard-max-age-days-description"
          },
          "persistence": "beforeApply",
          "default": {
            "unlimited": false,
            "value": 7
          },
          "minimum": 1,
          "maximum": 3650,
          "multipleOf": 1
        }
      }
    }
  }
}
