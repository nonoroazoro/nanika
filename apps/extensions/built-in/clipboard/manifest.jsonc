{
  "format": "nanika-extension",
  "manifestVersion": 1,
  "id": "com.nanika.clipboard",
  "name": "Clipboard History",
  "icon": "assets/icon.png",
  "version": "0.1.0",
  "hostApi": "^0.1",
  "targets": {
    "x86_64-pc-windows-msvc": { "entrypoint": "bin/x86_64-pc-windows-msvc/nanika-extension-clipboard.exe" },
    "aarch64-apple-darwin": { "entrypoint": "bin/aarch64-apple-darwin/nanika-extension-clipboard" },
    "x86_64-apple-darwin": { "entrypoint": "bin/x86_64-apple-darwin/nanika-extension-clipboard" }
  },
  "runtime": { "protocol": "nanika", "protocolVersion": 1 },
  "permissions": ["clipboard.write"],
  "contributes": {
    "views": [
      {
        "id": "clipboard.history",
        "title": "Clipboard History",
        "description": "Search and copy previous clipboard content.",
        "icon": "assets/icon.png",
        "keywords": ["clipboard", "history", "paste"]
      }
    ],
    "configuration": {
      "title": "Clipboard History",
      "quickMenu": [
        { "title": "Appearance", "items": [{ "kind": "toggle", "key": "clipboard.syntaxHighlighting" }] },
        { "title": "Danger zone", "items": [{ "kind": "action", "id": "clipboard.clear" }] }
      ],
      "actions": [{
        "buttonLabel": "Clear",
        "action": {
          "id": "clipboard.clear",
          "title": "Clear history",
          "style": "destructive",
          "enabled": true,
          "allow_default_execution": false,
          "confirmation_title": "Clear all history?",
          "confirmation_description": "All clipboard history will be permanently deleted. This cannot be undone.",
          "group": "Danger zone"
        },
        "description": "Permanently delete all clipboard history. This cannot be undone."
      }],
      "properties": {
        "clipboard.syntaxHighlighting": {
          "type": "boolean",
          "title": "Syntax highlighting",
          "group": "Appearance",
          "order": 0,
          "description": "Color recognized code and Markdown in text previews.",
          "persistence": "afterApply", "default": true
        },
        "clipboard.maxEntries": {
          "type": "integerLimit",
          "title": "Maximum history entries",
          "group": "History retention",
          "order": 1,
          "description": "Maximum number of clipboard history entries retained locally.",
          "persistence": "beforeApply", "default": { "unlimited": false, "value": 50 },
          "minimum": 1,
          "maximum": 5000,
          "multipleOf": 1
        },
        "clipboard.maxAgeDays": {
          "type": "integerLimit",
          "title": "Maximum age in days",
          "group": "History retention",
          "order": 2,
          "description": "Maximum age of clipboard history retained locally.",
          "persistence": "beforeApply", "default": { "unlimited": false, "value": 7 },
          "minimum": 1,
          "maximum": 3650,
          "multipleOf": 1
        }
      }
    }
  }
}
