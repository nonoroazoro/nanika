{
  "format": "nanika-extension",
  "manifestVersion": 1,
  "id": "com.nanika.system",
  "name": {
    "message": "extension-name"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": [
        "locales/en.ftl"
      ],
      "zh-Hans": [
        "locales/zh-Hans.ftl"
      ]
    }
  },
  "icon": "assets/icon.png",
  "version": "0.1.0",
  "hostApi": "^0.1",
  "activation": "onDemand",
  "targets": {
    "x86_64-pc-windows-msvc": {
      "entrypoint": "bin/x86_64-pc-windows-msvc/nanika-extension-system.exe"
    },
    "aarch64-apple-darwin": {
      "entrypoint": "bin/aarch64-apple-darwin/nanika-extension-system"
    },
    "x86_64-apple-darwin": {
      "entrypoint": "bin/x86_64-apple-darwin/nanika-extension-system"
    }
  },
  "runtime": {
    "protocol": "nanika",
    "protocolVersion": 1
  },
  "permissions": [
    "system.lock",
    "system.sleep",
    "system.displays",
    "system.logout",
    "system.restart",
    "system.shutdown",
    "system.trash.open",
    "system.trash.empty"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lock",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-lock-title"
          },
          "style": "primary",
          "enabled": true,
          "allow_default_execution": true,
          "group": null,
          "icon": "lock-keyhole"
        },
        "title": {
          "message": "action-lock-title"
        },
        "description": {
          "message": "command-lock-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-lock"
          },
          {
            "message": "keyword-screen"
          }
        ]
      },
      {
        "command": "sleep",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-sleep-title"
          },
          "style": "primary",
          "enabled": true,
          "allow_default_execution": true,
          "group": null,
          "icon": "moon"
        },
        "title": {
          "message": "action-sleep-title"
        },
        "description": {
          "message": "command-sleep-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-sleep"
          },
          {
            "message": "keyword-suspend"
          }
        ]
      },
      {
        "command": "displays",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-displays-title"
          },
          "style": "primary",
          "enabled": true,
          "allow_default_execution": true,
          "group": null,
          "icon": "monitor-off"
        },
        "title": {
          "message": "action-displays-title"
        },
        "description": {
          "message": "command-displays-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-display"
          },
          {
            "message": "keyword-monitor"
          },
          {
            "message": "keyword-screen"
          },
          {
            "message": "keyword-turn-off-display"
          }
        ]
      },
      {
        "command": "logout",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-logout-title"
          },
          "style": "destructive",
          "enabled": true,
          "allow_default_execution": false,
          "group": null,
          "confirmation_title": {
            "message": "action-logout-confirmation-title"
          },
          "confirmation_description": {
            "message": "action-logout-confirmation-description"
          },
          "icon": "log-out"
        },
        "title": {
          "message": "action-logout-title"
        },
        "description": {
          "message": "command-logout-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-logout"
          },
          {
            "message": "keyword-sign-out"
          }
        ]
      },
      {
        "command": "restart",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-restart-title"
          },
          "style": "destructive",
          "enabled": true,
          "allow_default_execution": false,
          "group": null,
          "confirmation_title": {
            "message": "action-restart-confirmation-title"
          },
          "confirmation_description": {
            "message": "action-restart-confirmation-description"
          },
          "icon": "rotate-cw"
        },
        "title": {
          "message": "action-restart-title"
        },
        "description": {
          "message": "command-restart-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-reboot"
          },
          {
            "message": "keyword-restart"
          }
        ]
      },
      {
        "command": "shutdown",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-shutdown-title"
          },
          "style": "destructive",
          "enabled": true,
          "allow_default_execution": false,
          "group": null,
          "confirmation_title": {
            "message": "action-shutdown-confirmation-title"
          },
          "confirmation_description": {
            "message": "action-shutdown-confirmation-description"
          },
          "icon": "power"
        },
        "title": {
          "message": "action-shutdown-title"
        },
        "description": {
          "message": "command-shutdown-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-shutdown"
          },
          {
            "message": "keyword-power-off"
          }
        ]
      },
      {
        "command": "trash.open",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-trash-open-title"
          },
          "style": "primary",
          "enabled": true,
          "allow_default_execution": true,
          "group": null,
          "icon": "folder-open"
        },
        "title": {
          "message": "action-trash-open-title"
        },
        "description": {
          "message": "command-trash-open-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-trash"
          },
          {
            "message": "keyword-recycle-bin"
          }
        ]
      },
      {
        "command": "trash.empty",
        "action": {
          "id": "command.execute",
          "title": {
            "message": "action-trash-empty-title"
          },
          "style": "destructive",
          "enabled": true,
          "allow_default_execution": false,
          "group": null,
          "confirmation_title": {
            "message": "action-trash-empty-confirmation-title"
          },
          "confirmation_description": {
            "message": "action-trash-empty-confirmation-description"
          },
          "icon": "trash"
        },
        "title": {
          "message": "action-trash-empty-title"
        },
        "description": {
          "message": "command-trash-empty-description"
        },
        "category": {
          "message": "extension-name"
        },
        "keywords": [
          {
            "message": "keyword-trash"
          },
          {
            "message": "keyword-recycle-bin"
          },
          {
            "message": "keyword-delete"
          },
          {
            "message": "keyword-empty-recycle-bin"
          }
        ]
      }
    ]
  }
}
