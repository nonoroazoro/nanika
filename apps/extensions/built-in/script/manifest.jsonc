{
  "format": "nanika-extension",
  "manifestVersion": 1,
  "id": "com.nanika.script",
  "name": "Scripts",
  "icon": "script",
  "version": "0.1.0",
  "hostApi": "^0.1",
  "targets": {
    "x86_64-pc-windows-msvc": {
      "entrypoint": "bin/x86_64-pc-windows-msvc/nanika-extension-script.exe"
    },
    "aarch64-apple-darwin": {
      "entrypoint": "bin/aarch64-apple-darwin/nanika-extension-script"
    },
    "x86_64-apple-darwin": {
      "entrypoint": "bin/x86_64-apple-darwin/nanika-extension-script"
    }
  },
  "runtime": {
    "protocol": "nanika",
    "protocolVersion": 1
  },
  "permissions": [
    "process.launch"
  ],
  "contributes": {
    "configuration": {
      "title": "Scripts",
      "properties": {
        "script.roots": {
          "type": "array",
          "title": "Folders",
          "description": "Find PowerShell, Python, JavaScript, and shell scripts in these folders.",
          "default": [],
          "maxItems": 256,
          "items": {
            "type": "string",
            "format": "directory",
            "maxLength": 4096
          }
        }
      }
    },
    "rootSearch": {}
  }
}
