{
  "format": "nanika-extension",
  "manifestVersion": 1,
  "id": "com.nanika.script",
  "name": {
    "message": "extension-name"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": [
        "locales/en.ftl"
      ],
      "zh-Hans": [
        "locales/zh-Hans.ftl"
      ]
    }
  },
  "icon": "assets/icon.png",
  "version": "0.1.0",
  "hostApi": "^0.1",
  "targets": {
    "x86_64-pc-windows-msvc": {
      "entrypoint": "bin/x86_64-pc-windows-msvc/nanika-extension-script.exe"
    },
    "aarch64-apple-darwin": {
      "entrypoint": "bin/aarch64-apple-darwin/nanika-extension-script"
    },
    "x86_64-apple-darwin": {
      "entrypoint": "bin/x86_64-apple-darwin/nanika-extension-script"
    }
  },
  "runtime": {
    "protocol": "nanika",
    "protocolVersion": 1
  },
  "permissions": [
    "process.launch"
  ],
  "contributes": {
    "configuration": {
      "title": {
        "message": "extension-name"
      },
      "properties": {
        "script.roots": {
          "type": "array",
          "title": {
            "message": "setting-script-roots-title"
          },
          "description": {
            "message": "setting-script-roots-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": [],
          "maxItems": 256,
          "items": {
            "type": "string",
            "format": "directory",
            "maxLength": 4096
          }
        }
      }
    },
    "rootSearch": {
      "mode": "catalog"
    }
  }
}
