{
  "format": "nanika-extension",
  "manifestVersion": 1,
  "id": "com.nanika.application",
  "name": {
    "message": "extension-name"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": [
        "locales/en.ftl"
      ],
      "zh-Hans": [
        "locales/zh-Hans.ftl"
      ]
    }
  },
  "icon": "assets/icon.png",
  "version": "0.1.0",
  "hostApi": "^0.1",
  "targets": {
    "x86_64-pc-windows-msvc": {
      "entrypoint": "bin/x86_64-pc-windows-msvc/nanika-extension-application.exe"
    },
    "aarch64-apple-darwin": {
      "entrypoint": "bin/aarch64-apple-darwin/nanika-extension-application"
    },
    "x86_64-apple-darwin": {
      "entrypoint": "bin/x86_64-apple-darwin/nanika-extension-application"
    }
  },
  "runtime": {
    "protocol": "nanika",
    "protocolVersion": 1
  },
  "permissions": [
    "process.launch",
    "files.reveal"
  ],
  "contributes": {
    "configuration": {
      "title": {
        "message": "extension-name"
      },
      "properties": {
        "application.builtin.macos.systemApplications": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-macos-system-applications-title"
          },
          "description": {
            "message": "setting-application-builtin-macos-system-applications-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "macos"
          ],
          "order": 10
        },
        "application.builtin.macos.userApplications": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-macos-user-applications-title"
          },
          "description": {
            "message": "setting-application-builtin-macos-user-applications-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "macos"
          ],
          "order": 20
        },
        "application.builtin.windows.packaged": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-windows-packaged-title"
          },
          "description": {
            "message": "setting-application-builtin-windows-packaged-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "windows"
          ],
          "order": 10
        },
        "application.builtin.windows.systemPrograms": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-windows-system-programs-title"
          },
          "description": {
            "message": "setting-application-builtin-windows-system-programs-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "windows"
          ],
          "order": 20
        },
        "application.builtin.windows.scoopGlobal": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-windows-scoop-global-title"
          },
          "description": {
            "message": "setting-application-builtin-windows-scoop-global-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "windows"
          ],
          "order": 30
        },
        "application.builtin.windows.scoopUser": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-windows-scoop-user-title"
          },
          "description": {
            "message": "setting-application-builtin-windows-scoop-user-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "windows"
          ],
          "order": 40
        },
        "application.builtin.windows.userPrograms": {
          "type": "boolean",
          "title": {
            "message": "setting-application-builtin-windows-user-programs-title"
          },
          "description": {
            "message": "setting-application-builtin-windows-user-programs-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": true,
          "platforms": [
            "windows"
          ],
          "order": 60
        },
        "application.roots": {
          "type": "array",
          "title": {
            "message": "setting-application-roots-title"
          },
          "description": {
            "message": "setting-application-roots-description"
          },
          "group": {
            "id": "search-locations",
            "title": {
              "message": "group-search-locations"
            }
          },
          "persistence": "beforeApply",
          "default": [],
          "order": 100,
          "maxItems": 256,
          "items": {
            "type": "string",
            "format": "directory",
            "maxLength": 4096
          }
        }
      }
    },
    "rootSearch": {
      "mode": "catalog"
    }
  }
}
